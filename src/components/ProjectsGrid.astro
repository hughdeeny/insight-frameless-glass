---
import { Image } from 'astro:assets';
import { projects } from '../data/site';
import triangleIcon from '../assets/icons/project-triangle-icon.svg?raw';
import sylvania from '../assets/images/project-sylvania.webp';
import whaleBeach from '../assets/images/project-whale-beach.webp';
import mosman from '../assets/images/project-mosman.webp';
import turramurra from '../assets/images/project-turramurra.jpg';

const images = {
  sylvania,
  whaleBeach,
  mosman,
  turramurra,
} as const;
---

<section class="projects" id="projects">
  <div class="shell">
    <h2 class="sr-only">Projects</h2>
    <ul class="grid">
      {
        projects.map((project) => (
          <li>
            <a class="card" href={`/projects/${project.slug}`}>
              <Image
                src={images[project.image]}
                alt={project.alt}
                widths={[480, 800, 1200]}
                sizes="(min-width: 768px) 50vw, 100vw"
                quality={80}
                class="photo"
              />
              <span class="overlay">
                <span class="triangle" set:html={triangleIcon} />
                <span class="name">{project.name}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .projects {
    padding-bottom: 0;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  .card {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    color: var(--color-white);
    text-decoration: none;
    background: var(--color-photo);
  }

  .photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.001);
    filter: brightness(1.04);
    transition: transform 0.9s var(--ease), filter 0.9s var(--ease);
  }

  .overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.15rem;
    background: var(--color-overlay);
    transition: background-color var(--duration) var(--ease);
  }

  .triangle {
    display: block;
    flex-shrink: 0;
    width: 2.4rem;
    height: 2.4rem;
    color: var(--color-white);
    filter: drop-shadow(0 1px 10px rgba(0, 0, 0, 0.35));
  }

  .triangle :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .name {
    display: block;
    font-size: 0.78rem;
    font-weight: var(--weight-regular);
    letter-spacing: 0.26em;
    text-transform: uppercase;
    line-height: 1;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.4);
  }

  .card:hover .photo,
  .card:focus-visible .photo {
    transform: scale(1.02);
    filter: brightness(1.08);
  }

  .card:hover .overlay,
  .card:focus-visible .overlay {
    background: var(--color-overlay-hover);
  }

  @media (min-width: 700px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }

    .card {
      aspect-ratio: 4 / 3.05;
      min-height: 18rem;
    }

    .triangle {
      width: 2.75rem;
      height: 2.75rem;
    }

    .name {
      font-size: 0.82rem;
      letter-spacing: 0.28em;
    }
  }

  @media (min-width: 1024px) {
    .card {
      min-height: 22rem;
      aspect-ratio: 4 / 3;
    }

    .triangle {
      width: 3.25rem;
      height: 3.25rem;
    }
  }
</style>
