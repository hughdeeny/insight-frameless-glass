---
import logoMark from '../assets/images/logo-mark.svg?raw';
import { navItems, site } from '../data/site';

const path = Astro.url.pathname;
---

<header class="header">
  <div class="shell bar">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <span class="mark" set:html={logoMark} />
    </a>

    <div class="tools">
      <a class="call" href={site.phoneHref}>
        <span class="call-kicker">Call now</span>
        <span class="call-number">{site.phone}</span>
      </a>

      <details class="nav" id="site-nav">
        <summary class="menu-btn">
          <span class="burger" aria-hidden="true">
            <span></span>
            <span></span>
          </span>
          <span class="menu-label">Menu</span>
        </summary>

        <div class="panel">
          <nav class="panel-nav" aria-label="Primary">
            <ul>
              {
                navItems.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      aria-current={
                        item.href === '/'
                          ? path === '/' ? 'page' : undefined
                          : path === item.href || path.startsWith(`${item.href}/`)
                            ? 'page'
                            : undefined
                      }
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const nav = document.getElementById('site-nav');
    if (!(nav instanceof HTMLDetailsElement)) return;

    const setOpen = () => {
      document.body.classList.toggle('nav-open', nav.open);
      nav.querySelector('summary')?.setAttribute('aria-expanded', String(nav.open));
    };

    nav.addEventListener('toggle', setOpen);
    setOpen();

    window.addEventListener('pageshow', () => {
      nav.open = false;
      setOpen();
    });

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        window.setTimeout(() => {
          nav.open = false;
        }, 0);
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') nav.open = false;
    });
  })();
</script>

<style>
  .header {
    position: relative;
    z-index: 120;
    background: var(--color-bg);
    min-height: var(--header-height);
    border-bottom: 1px solid var(--color-line);
  }

  :global(body.nav-open) .header {
    background: transparent;
    border-bottom-color: transparent;
  }

  :global(body.nav-open) .brand {
    visibility: hidden;
  }

  :global(body.nav-open) .call {
    color: var(--color-white);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-height);
  }

  .brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    opacity: 0.92;
    transition: opacity var(--duration-fast) var(--ease);
  }

  .brand:hover,
  .brand:focus-visible {
    opacity: 1;
  }

  .mark {
    display: block;
    width: 34px;
    height: 34px;
  }

  .mark :global(svg) {
    width: 100%;
    height: 100%;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .call {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.22rem;
    text-decoration: none;
    color: var(--color-rule);
    padding: 0.15rem 0;
    transition: opacity var(--duration-fast) var(--ease);
  }

  .call:hover,
  .call:focus-visible {
    opacity: 0.62;
  }

  .call-kicker {
    font-size: 0.625rem;
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: 1;
  }

  .call-number {
    font-size: 0.78rem;
    font-weight: var(--weight-regular);
    letter-spacing: 0.04em;
    line-height: 1;
    white-space: nowrap;
  }

  .menu-btn {
    position: relative;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    list-style: none;
    cursor: pointer;
    color: var(--color-rule);
    padding: 0.45rem 0.1rem;
    transition: color var(--duration-fast) var(--ease);
  }

  .nav[open] .menu-btn {
    color: var(--color-white);
  }

  .menu-btn::-webkit-details-marker,
  .menu-btn::marker {
    display: none;
    content: '';
  }

  .menu-label {
    display: none;
    font-size: var(--text-label);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: 1;
  }

  .burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 20px;
  }

  .burger span {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform var(--duration-fast) var(--ease), width var(--duration-fast) var(--ease);
  }

  .burger span:first-child {
    width: 20px;
  }

  .burger span:last-child {
    width: 13px;
  }

  .nav[open] .burger span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .nav[open] .burger span:last-child {
    width: 20px;
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .nav[open] .menu-label {
    visibility: hidden;
  }

  .panel {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    background: var(--color-navy);
    padding: 5rem 1.5rem 3rem;
  }

  .panel-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: center;
  }

  .panel-nav a {
    display: inline-block;
    padding: 0.75rem 0.5rem;
    color: var(--color-white);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    font-size: 0.82rem;
    font-weight: var(--weight-regular);
    opacity: 0.78;
    transition: opacity var(--duration-fast) var(--ease);
  }

  .panel-nav a:hover,
  .panel-nav a:focus-visible,
  .panel-nav a[aria-current='page'] {
    opacity: 1;
  }

  @media (min-width: 768px) {
    .mark {
      width: 40px;
      height: 40px;
    }

    .menu-label {
      display: inline;
    }

    .tools {
      gap: 1.6rem;
    }

    .call-kicker {
      font-size: var(--text-label);
    }

    .call-number {
      font-size: 0.9rem;
    }

    .panel-nav a {
      font-size: 0.95rem;
      padding: 0.9rem 0.5rem;
      letter-spacing: 0.36em;
    }
  }
</style>
