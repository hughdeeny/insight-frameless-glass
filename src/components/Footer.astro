---
import { Image } from 'astro:assets';
import logoStacked from '../assets/images/logo-stacked.png';
import { navItems, site, socials } from '../data/site';
import LeadForm from './LeadForm.astro';
---

<LeadForm />
<div class="band">
  <div class="shell">
    <footer class="footer">
      <div class="inner">
        <div class="top">
          <a class="brand" href="/" aria-label={`${site.name} home`}>
            <Image
              src={logoStacked}
              alt=""
              width={168}
              height={192}
              widths={[168, 336]}
              sizes="168px"
              class="logo"
            />
          </a>
          <ul class="socials">
            {
              socials.map((item) => (
                <li>
                  <a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.label}>
                    {item.icon === 'linkedin' && (
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <rect x="3" y="3" width="18" height="18" rx="1" stroke="currentColor" stroke-width="1.3" />
                        <path d="M8 10.5V17M8 7.5v.2M12 17v-4.2c0-1.3.7-2.3 2.1-2.3 1.4 0 1.9 1 1.9 2.4V17" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                      </svg>
                    )}
                    {item.icon === 'facebook' && (
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.3" />
                        <path d="M13 8h1.6M13 12h2.4M13 8v8M13 8h-1.4A1.6 1.6 0 0 0 10 9.6V12" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                      </svg>
                    )}
                    {item.icon === 'instagram' && (
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <rect x="4" y="4" width="16" height="16" rx="4" stroke="currentColor" stroke-width="1.3" />
                        <circle cx="12" cy="12" r="3.4" stroke="currentColor" stroke-width="1.3" />
                        <circle cx="16.4" cy="7.6" r="0.8" fill="currentColor" />
                      </svg>
                    )}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="bottom">
          <nav aria-label="Footer">
            <ul class="links">
              {
                navItems.map((item) => (
                  <li>
                    <a href={item.href}>{item.label}</a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <p class="copy">&copy; {site.name}</p>
        </div>
      </div>
    </footer>
  </div>
</div>

<style>
  .band {
    padding-bottom: 0.7rem;
    background: var(--color-bg);
  }

  .footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: var(--color-white);
    background-color: var(--color-navy);
    background-image: url('/images/footer-pattern.png?v=2');
    background-size: cover;
    background-position: center;
    border-radius: var(--radius-frame);
    min-height: 22rem;
  }

  .inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 22rem;
    padding: 3.5rem var(--gutter) 2rem;
    gap: 4rem;
  }

  .top,
  .bottom {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .brand {
    display: block;
    width: 7.5rem;
  }

  .logo {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .top {
    align-items: flex-start;
  }

  .socials {
    display: flex;
    gap: 0.85rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .socials a {
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    color: var(--color-white);
    transition: opacity var(--duration-fast) var(--ease);
  }

  .socials a:hover,
  .socials a:focus-visible {
    opacity: 0.65;
  }

  .socials svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .links a {
    color: var(--color-white);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    font-size: var(--text-label);
    transition: opacity var(--duration-fast) var(--ease);
  }

  .links a:hover,
  .links a:focus-visible {
    opacity: 0.65;
  }

  .copy {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    font-weight: var(--weight-light);
    opacity: 0.72;
  }

  @media (min-width: 768px) {
    .footer,
    .inner {
      min-height: 28rem;
    }

    .inner {
      padding-block: 5rem 2.5rem;
    }

    .top,
    .bottom {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }

    .top {
      align-items: flex-start;
    }

    .brand {
      width: 9.5rem;
    }
  }

  @media (min-width: 1024px) {
    .band {
      padding-bottom: 0.9rem;
    }

    .footer,
    .inner {
      min-height: 32rem;
    }

    .inner {
      padding-block: 6rem 2.75rem;
    }

    .brand {
      width: 10.5rem;
    }
  }
</style>
