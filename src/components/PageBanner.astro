---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  label: string;
  alt: string;
}

const { image, label, alt } = Astro.props;
---

<section class="banner" aria-label={label}>
  <Image
    src={image}
    alt={alt}
    widths={[720, 1100, 1600]}
    sizes="(min-width: 1440px) 1400px, 100vw"
    quality={80}
    class="photo"
  />
  <p class="label">{label}</p>
</section>

<style>
  .banner {
    position: relative;
    overflow: hidden;
    min-height: 12rem;
    aspect-ratio: 16 / 6;
    background: #111;
    color: #fff;
  }

  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.38) 0%,
      rgba(0, 0, 0, 0.16) 55%,
      rgba(0, 0, 0, 0.28) 100%
    );
  }

  .label {
    position: absolute;
    z-index: 1;
    left: var(--gutter);
    top: 1.4rem;
    margin: 0;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }

  @media (min-width: 768px) {
    .banner {
      min-height: 16rem;
      aspect-ratio: 21 / 6;
    }

    .label {
      top: 1.8rem;
      font-size: 0.9rem;
    }
  }
</style>
