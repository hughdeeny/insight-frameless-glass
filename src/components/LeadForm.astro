---
const formId = '6ctsjNoKtJ8i6YmCDxMg';
const iframeId = `inline-${formId}`;
---

<section class="lead-form" aria-label="Website Form">
  <div class="shell">
    <div class="frame">
      <iframe
        src={`https://links.screwdrivermarketing.com.au/widget/form/${formId}`}
        style="width:100%;height:100%;border:none;border-radius:10px"
        id={iframeId}
        data-layout={"{'id':'INLINE'}"}
        data-trigger-type="alwaysShow"
        data-trigger-value=""
        data-activation-type="alwaysActivated"
        data-activation-value=""
        data-deactivation-type="neverDeactivate"
        data-deactivation-value=""
        data-form-name="Website Form"
        data-height="564"
        data-layout-iframe-id={iframeId}
        data-form-id={formId}
        data-cookie-consent="true"
        data-cookie-consent-provider="auto"
        title="Website Form"
      ></iframe>
    </div>
  </div>
</section>

<script is:inline src="https://links.screwdrivermarketing.com.au/js/form_embed.js"></script>

<style>
  .lead-form {
    padding-block: 3.5rem 2.5rem;
    background: #fff;
  }

  .frame {
    width: 100%;
    min-height: 564px;
    border-radius: 10px;
  }

  iframe {
    display: block;
    width: 100%;
    height: 564px;
    max-width: none;
    border: 0;
  }

  @media (min-width: 900px) {
    .lead-form {
      padding-block: 4.5rem 3rem;
    }
  }
</style>
