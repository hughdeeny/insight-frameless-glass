---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---

<Layout
  title="Contact Insight Frameless Glass | Sydney"
  description="Contact Insight Frameless Glass in Sydney for a free quote on glass pool fencing, balustrades, stairways and shower screens."
>
  <Header />
  <main id="main">
    <section class="page-block">
      <div class="shell intro">
        <h1>Get in touch</h1>
        <p class="details">
          <a href={site.phoneHref}>Phone — {site.phone}</a>
          <a href={`mailto:${site.email}`}>Email — {site.email}</a>
        </p>
        <p>
          We endeavour to respond to all enquiries within one business day. If
          you require a faster response, please feel free to contact us via
          phone.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-block {
    padding-bottom: 0;
  }

  h1 {
    font-size: var(--text-h1);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    margin-bottom: 1.5rem;
  }

  .intro p {
    max-width: 36rem;
    line-height: 1.7;
  }

  .details {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1.35rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    font-size: var(--text-label);
  }

  .details a {
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0 1px;
    transition: background-size var(--duration-fast) var(--ease);
  }

  .details a:hover,
  .details a:focus-visible {
    background-size: 100% 1px;
  }
</style>
