---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero-glass.png';
import { site } from '../data/site';
---

<section class="hero" aria-label="Introduction">
  <div class="frame">
    <Image
      src={heroImage}
      alt={`${site.name} logo over stacked architectural glass sheets`}
      widths={[720, 1100, 1600, 1920, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      quality={85}
      class="photo"
    />
  </div>
</section>

<style>
  .hero {
    padding: 0.15rem 0.4rem 0.55rem;
  }

  .frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    min-height: 26rem;
    background: var(--color-photo);
  }

  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  @media (min-width: 600px) {
    .hero {
      padding: 0.18rem 0.45rem 0.6rem;
    }

    .frame {
      aspect-ratio: 16 / 9;
      min-height: 0;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      padding: 0.2rem 0.5rem 0.7rem;
    }

    .frame {
      aspect-ratio: 16 / 9;
      max-height: 92vh;
    }
  }
</style>
