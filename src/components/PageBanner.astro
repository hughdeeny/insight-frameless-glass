---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  label: string;
  alt: string;
}

const { image, label, alt } = Astro.props;
---

<section class="banner" aria-label={label}>
  <Image
    src={image}
    alt={alt}
    widths={[720, 1100, 1600]}
    sizes="(min-width: 1920px) 1880px, 100vw"
    quality={80}
    class="photo"
  />
  <p class="label">{label}</p>
</section>

<style>
  .banner {
    position: relative;
    overflow: hidden;
    min-height: 12rem;
    aspect-ratio: 16 / 6;
    background: var(--color-photo);
    border-radius: var(--radius-frame);
    color: var(--color-white);
  }

  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(12, 12, 12, 0.16) 0%,
      rgba(12, 12, 12, 0.02) 50%,
      rgba(12, 12, 12, 0.1) 100%
    );
  }

  .label {
    position: absolute;
    z-index: 1;
    left: var(--gutter);
    top: 1.4rem;
    margin: 0;
    font-size: var(--text-label);
    font-weight: var(--weight-regular);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.35);
  }

  @media (min-width: 768px) {
    .banner {
      min-height: 16rem;
      aspect-ratio: 21 / 6;
    }

    .label {
      top: 1.8rem;
      font-size: 0.75rem;
    }
  }
</style>
