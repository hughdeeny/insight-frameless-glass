---
import { services, type ServiceIcon } from '../data/site';
import poolIcon from '../assets/icons/pool-icon.svg?raw';
import balustradeIcon from '../assets/icons/balustrade-icon.svg?raw';
import slatIcon from '../assets/icons/slat-fence-icon.svg?raw';
import stairIcon from '../assets/icons/stair-glass-icon.svg?raw';
import showerIcon from '../assets/icons/shower-icon.svg?raw';
import flatTopIcon from '../assets/icons/flat-top-fencing.svg?raw';

const icons: Record<ServiceIcon, string> = {
  pool: poolIcon,
  balustrade: balustradeIcon,
  slat: slatIcon,
  stair: stairIcon,
  shower: showerIcon,
  'flat-top': flatTopIcon,
};
---

<section class="services" id="services">
  <div class="shell">
    <h2 class="sr-only">Services</h2>
    <ul class="grid">
      {
        services.map((service) => (
          <li>
            <a class="item" href={service.href}>
              <span class="icon" set:html={icons[service.icon]} />
              <span class="label">{service.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .services {
    padding-block: 1.5rem 3.5rem;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.25rem 1.25rem;
  }

  .item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 1.1rem;
    min-height: 8.5rem;
    padding: 1.25rem 0.75rem;
    text-align: center;
    text-decoration: none;
    color: var(--color-muted);
    transition: color 0.25s ease;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    color: #4a4a4a;
    transition: transform 0.3s ease, color 0.25s ease;
  }

  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .label {
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.45;
    max-width: 14rem;
  }

  .item:hover,
  .item:focus-visible {
    color: var(--color-text);
  }

  .item:hover .icon,
  .item:focus-visible .icon {
    color: var(--color-rule);
    transform: translateY(-3px);
  }

  @media (min-width: 900px) {
    .services {
      padding-block: 1rem 5rem;
    }

    .grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.4rem 2.5rem;
    }

    .item {
      min-height: 10.5rem;
      padding: 1.75rem 1rem 2rem;
    }

    .icon {
      width: 4.25rem;
      height: 4.25rem;
    }

    .label {
      font-size: 0.8125rem;
      letter-spacing: 0.12em;
    }
  }
</style>
